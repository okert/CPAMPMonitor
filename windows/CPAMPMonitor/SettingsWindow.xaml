<Window x:Class="CPAMP.Windows.SettingsWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="CPAMP Monitor - Settings" Width="560" Height="760" MinWidth="420" MinHeight="480"
 WindowStartupLocation="CenterScreen">
 <DockPanel Margin="20">
  <StackPanel DockPanel.Dock="Bottom">
   <TextBlock x:Name="Message" TextWrapping="Wrap" Foreground="#B42318" Margin="0,10" />
   <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
    <Button Content="Cancel" Click="Cancel_Click" IsCancel="True" />
    <Button Content="Save and connect" Click="Save_Click" IsDefault="True" />
   </StackPanel>
  </StackPanel>
  <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
   <StackPanel Margin="0,0,12,0">
    <TextBlock Text="Connection" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,12" />
    <Label Content="_Name" Target="{Binding ElementName=ConnectionName}" Padding="0" />
    <TextBox x:Name="ConnectionName" MaxLength="80" />
    <Label Content="Service _URL" Target="{Binding ElementName=ServiceUrl}" Padding="0" />
    <TextBox x:Name="ServiceUrl" MaxLength="2048" />
    <Label Content="Management _key" Target="{Binding ElementName=Secret}" Padding="0" />
    <PasswordBox x:Name="Secret" MaxLength="1280" ToolTip="Leave blank to keep the key saved for this address." />
    <TextBlock Text="Monitoring" FontSize="18" FontWeight="SemiBold" Margin="0,12,0,12" />
    <Label Content="Refresh interval (_minutes)" Target="{Binding ElementName=Interval}" Padding="0" />
    <TextBox x:Name="Interval" MaxLength="2" />
    <Grid>
     <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition /></Grid.ColumnDefinitions>
     <StackPanel Margin="0,0,8,0"><Label Content="_Warning (%)" Target="{Binding ElementName=Warning}" Padding="0" /><TextBox x:Name="Warning" MaxLength="2" /></StackPanel>
     <StackPanel Grid.Column="1" Margin="8,0,0,0"><Label Content="_Critical (%)" Target="{Binding ElementName=Critical}" Padding="0" /><TextBox x:Name="Critical" MaxLength="2" /></StackPanel>
    </Grid>
    <CheckBox x:Name="Startup" Content="Start at sign-in" />
    <CheckBox x:Name="Notifications" Content="Quota notifications" />
    <Button Content="Test notification" HorizontalAlignment="Left" Click="Test_Click" />
    <TextBlock Text="Accounts" FontSize="18" FontWeight="SemiBold" Margin="0,20,0,10" />
    <DockPanel>
     <StackPanel DockPanel.Dock="Right" Margin="4,0,0,0">
      <Button Style="{StaticResource Tool}" Content="&#xE70E;" ToolTip="Move up" AutomationProperties.Name="Move up" Click="Up_Click" />
      <Button Style="{StaticResource Tool}" Content="&#xE70D;" ToolTip="Move down" AutomationProperties.Name="Move down" Click="Down_Click" />
     </StackPanel>
     <ListBox x:Name="Accounts" Height="190" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
      <ListBox.ItemContainerStyle><Style TargetType="ListBoxItem"><Setter Property="HorizontalContentAlignment" Value="Stretch" /></Style></ListBox.ItemContainerStyle>
      <ListBox.ItemTemplate><DataTemplate>
       <CheckBox IsChecked="{Binding Enabled, Mode=TwoWay}" IsEnabled="{Binding Available}" Margin="4,6">
        <StackPanel><TextBlock Text="{Binding Title}" TextWrapping="Wrap" /><TextBlock Text="{Binding Provider}" FontSize="12" Opacity="0.7" /></StackPanel>
       </CheckBox>
      </DataTemplate></ListBox.ItemTemplate>
     </ListBox>
    </DockPanel>
   </StackPanel>
  </ScrollViewer>
 </DockPanel>
</Window>
