<Window x:Class="CPAMP.Windows.MainWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="CPAMP Monitor" Width="600" Height="730" MinWidth="400" MinHeight="360"
 WindowStartupLocation="CenterScreen">
 <DockPanel>
  <StackPanel DockPanel.Dock="Top" Margin="20,16,20,8">
   <DockPanel>
    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
     <Button x:Name="RefreshButton" Style="{StaticResource Tool}" Content="&#xE72C;" ToolTip="Refresh" AutomationProperties.Name="Refresh" Click="Refresh_Click" />
     <Button Style="{StaticResource Tool}" Content="&#xE713;" ToolTip="Settings" AutomationProperties.Name="Settings" Click="Settings_Click" />
    </StackPanel>
    <StackPanel>
     <TextBlock Text="CPAMP Monitor" FontSize="22" FontWeight="SemiBold" />
     <TextBlock x:Name="ConnectionName" TextWrapping="Wrap" Opacity="0.7" />
    </StackPanel>
   </DockPanel>
   <DockPanel Margin="0,16,0,6">
    <TextBlock x:Name="Lowest" DockPanel.Dock="Right" FontSize="30" FontWeight="SemiBold" TextWrapping="Wrap" TextAlignment="Right" MaxWidth="320" />
    <TextBlock x:Name="Status" VerticalAlignment="Center" FontWeight="SemiBold" />
   </DockPanel>
   <TextBlock x:Name="ErrorText" TextWrapping="Wrap" Foreground="#B42318" />
   <TextBlock x:Name="EmptyText" TextWrapping="Wrap" Margin="0,8,0,0" />
  </StackPanel>
  <StackPanel DockPanel.Dock="Bottom" Margin="16,8,16,12">
   <Separator />
   <TextBlock x:Name="RefreshTime" Margin="4,8" FontSize="12" Opacity="0.7" TextWrapping="Wrap" />
   <DockPanel>
    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
     <Button x:Name="PauseButton" Style="{StaticResource Tool}" Content="&#xE769;" ToolTip="Pause" AutomationProperties.Name="Pause" Click="Pause_Click" />
     <Button Style="{StaticResource Tool}" Content="&#xE7E8;" ToolTip="Quit" AutomationProperties.Name="Quit" Click="Quit_Click" />
    </StackPanel>
    <Button x:Name="DashboardButton" Content="Open service dashboard" HorizontalAlignment="Left" Click="Dashboard_Click" />
   </DockPanel>
  </StackPanel>
  <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
   <ItemsControl x:Name="Rows" Margin="20,0">
    <ItemsControl.ItemTemplate>
     <DataTemplate>
      <StackPanel Margin="0,8,0,12" Opacity="{Binding Opacity}">
       <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="16" TextWrapping="Wrap" />
       <TextBlock Text="{Binding Subtitle}" Opacity="0.7" TextWrapping="Wrap" Margin="0,3,0,8" />
       <TextBlock Text="{Binding Error}" Foreground="#B42318" TextWrapping="Wrap" />
       <ItemsControl ItemsSource="{Binding Windows}">
        <ItemsControl.ItemTemplate>
         <DataTemplate>
          <StackPanel Margin="0,4,0,8">
           <DockPanel>
            <TextBlock DockPanel.Dock="Right" Text="{Binding ValueText}" FontWeight="SemiBold" Margin="12,0,0,0" />
            <TextBlock Text="{Binding Title}" TextWrapping="Wrap" />
           </DockPanel>
           <ProgressBar Height="5" Minimum="0" Maximum="100" Value="{Binding Value, Mode=OneWay}" Foreground="{Binding Color}" Margin="0,5" />
           <TextBlock Text="{Binding ResetText}" FontSize="12" Opacity="0.7" TextWrapping="Wrap" />
          </StackPanel>
         </DataTemplate>
        </ItemsControl.ItemTemplate>
       </ItemsControl>
       <TextBlock Text="{Binding History}" FontSize="12" Opacity="0.7" TextWrapping="Wrap" Margin="0,4" />
       <Separator Margin="0,8,0,0" />
      </StackPanel>
     </DataTemplate>
    </ItemsControl.ItemTemplate>
   </ItemsControl>
  </ScrollViewer>
 </DockPanel>
</Window>
